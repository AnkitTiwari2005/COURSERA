{
  "manifest_version": 3,
  "name": "Coursera NVIDIA AI Solver",
  "version": "2.0.0",
  "default_locale": "en",
  "description": "Automatically detects and solves Coursera quiz questions using NVIDIA Nemotron 3.5 Super VL 120B.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png"
    }
  },
  "commands": {
    "solve-quiz": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q",
        "windows": "Alt+Q",
        "chromeos": "Alt+Q",
        "linux": "Alt+Q"
      },
      "description": "Solve Current Coursera Quiz"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.coursera.org/*",
    "https://integrate.api.nvidia.com/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/images/loading_spinner.gif",
        "settings/*",
        "content_scripts/coursera_solver.js",
        "content_scripts/modules/dom_detector.js",
        "content_scripts/modules/mutation_observer.js",
        "content_scripts/modules/ui_feedback.js",
        "content_scripts/modules/answer_renderer.js",
        "utils/constants.js",
        "utils/error_handler.js",
        "utils/cache_manager.js",
        "utils/storage_manager.js",
        "utils/smart_blocker.js",
        "utils/url_parser.js",
        "content_scripts/quiz_result_parser.js"
      ],
      "matches": ["https://www.coursera.org/*"]
    }
  ]
}
